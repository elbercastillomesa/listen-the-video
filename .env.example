# Copy this file to .env and fill in the values.

# Telegram bot token issued by @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Optional: restrict the bot to a single Telegram user id (personal use).
# Leave empty to allow any user (not recommended).
ALLOWED_USER_ID=

# Working directory for temporary downloads and output files.
DATA_DIR=data

# Output MP3 bitrate.
MP3_BITRATE=320k

# Maximum upload size in MB. The public Telegram Bot API caps uploads at 50 MB.
MAX_UPLOAD_MB=50

# Filename used for the delivered MP3. Tokens: {artist} {title} {album} {year}.
# Leave empty to keep the downloaded file's original name.
OUTPUT_FILENAME_TEMPLATE={artist} - {title}
